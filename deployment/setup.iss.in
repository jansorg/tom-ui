; This file is used to build setup.iss which is then fed to the Inno Setup compiler
; The variables used below come from the CMakeLists.txt

#if ${CMAKE_SIZEOF_VOID_P} == 8
  #define ARCH "x86_64"
#else
  #define ARCH "x86"
#endif

; LICENSE_FILE can be set by the compiler (ISCC /DLICENSE_FILE=...), e.g. if the source directory moved
#ifndef LICENSE_FILE
#define LICENSE_FILE "${CMAKE_SOURCE_DIR}\LICENSE.txt"
#endif

[Setup]
AppId                = {{174A4547-917E-4BAF-9F25-FCE545CCD487}
AppName              = "${PROJECT_NAME}"
AppVersion           = "${PROJECT_VERSION}"
AppPublisher         = "${COMPANY}"
DefaultDirName       = "{autopf}\${PROJECT_NAME}"
DefaultGroupName     = "${PROJECT_NAME}"
LicenseFile          = "{#LICENSE_FILE}"
MinVersion           = 10.0
OutputDir            = "${CMAKE_BINARY_DIR}"
OutputBaseFilename   = "tom-ui-${PROJECT_VERSION}-windows-{#ARCH}"
Compression          = lzma
SolidCompression     = yes

; Set two additional directives if we are building a 64-bit installer
#if ARCH == "x86_64"
ArchitecturesAllowed            = x64compatible
ArchitecturesInstallIn64BitMode = x64compatible
#endif

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "{#PREFIX}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\${PROJECT_NAME}"; Filename: "{app}\bin\tom-ui.exe"
Name: "{group}\{cm:UninstallProgram,${PROJECT_NAME}}"; Filename: "{uninstallexe}"
Name: "{commondesktop}\${PROJECT_NAME}"; Filename: "{app}\bin\tom-ui.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\bin\tom-ui.exe"; Description: "{cm:LaunchProgram,${PROJECT_NAME}}"; Flags: nowait postinstall skipifsilent
